<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed Draggable Bubble -->
    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:background="@drawable/bg_floating_bubble"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="PK Bubble"
            android:src="@mipmap/ic_launcher_round" />
    </LinearLayout>

    <!-- Expanded Mini Popup AI Assistant Card (Appears over WhatsApp / any app) -->
    <LinearLayout
        android:id="@+id/expandedPanel"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_floating_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="PKassist Live Popup"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPopupMinimize"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="✕"
                android:textColor="#F26522"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPopupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Boliye ya type karein (current app par kaam karega):"
            android:textColor="#D8DEE9"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPopupCommand"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_box"
                android:hint="e.g. type hello / tap send"
                android:paddingHorizontal="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#8892B0"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnPopupRun"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#2E3440"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Go"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnPopupMic"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#F26522"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🎤"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
