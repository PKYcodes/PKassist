<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="PKassist Logo"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PKassist"
                android:textColor="#181818"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hybrid AI (Online Gemini Lite + Offline Engine)"
                android:textColor="#F26522"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnApiKey"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textColor="#181818" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update"
            android:textColor="#F26522" />
    </LinearLayout>

    <!-- Accessibility & Permissions Quick Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3EC"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvAccessibilityStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Enable Accessibility for auto-typing &amp; screen control"
            android:textColor="#333333"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnEnableAccessibility"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="#F26522"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Enable"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Conversation Log -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvChatHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="PKassist Ready!\n\nTry commands (Online or Offline):\n• 'Call Rahul' or '9876543210 par call lagao'\n• 'Send SMS to 9876543210 I am on my way'\n• 'Open WhatsApp' / 'YouTube kholo'\n• 'Type Hello how are you'\n• 'Turn on flashlight' / 'Go home'\n"
            android:textColor="#222222"
            android:textSize="14sp" />
    </ScrollView>

    <!-- Command Input & Voice Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background_normal"
            android:hint="Ask or command PKassist..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#181818"
            android:text="Send"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#F26522"
            android:text="🎤 Speak"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Branded Footer: "— powered by RV GROUP —" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/ivRvFooter"
            android:layout_width="220dp"
            android:layout_height="38dp"
            android:adjustViewBounds="true"
            android:contentDescription="Powered by RV Group"
            android:scaleType="fitCenter"
            android:src="@drawable/rv_footer_badge" />

        <TextView
            android:id="@+id/tvVersionFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0.0 • GitHub Auto-Update Active"
            android:textColor="#888888"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
