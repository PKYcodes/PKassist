<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090C12"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Gemini-Glass Brand Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivAppLogo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="PKassist Logo"
            android:src="@mipmap/ic_launcher_round" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PKassist Ultra"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Gemini Glass • Lock-Screen &amp; Voice Unlock"
                android:textColor="#00E5FF"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVoicePin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="🔐 PIN"
            android:textColor="#FFD54F"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnApiKey"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="🔑 AI Key"
            android:textColor="#ECEFF4"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="⬇ Update"
            android:textColor="#F26522"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 2-Column Glass Control Center: Accessibility + Gemini Glass Background Service -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Card 1: Accessibility & Voice Unlock -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvAccessibilityStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Screen Engine Off"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Auto-Unlock, Type &amp; Click"
                android:textColor="#B0BEC5"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnEnableAccessibility"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#F26522"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Enable Engine"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Card 2: Gemini Glass Popup & 24/7 Lock-Screen Mic -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvFloatingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨ Gemini Glass Popup"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="24/7 Background + Lock Mic"
                android:textColor="#B0BEC5"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnToggleFloating"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#7C4DFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Launch Glass AI"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Action Glass Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipUnlock"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_chip"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🔓 Test Voice Unlock"
                android:textColor="#FFD54F"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipWhatsApp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_chip"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="💬 WhatsApp Auto"
                android:textColor="#ECEFF4"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipReadScreen"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_chip"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="👁 Read Screen"
                android:textColor="#00E5FF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipAlarm"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_chip"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="⏰ Alarm 6:30"
                android:textColor="#ECEFF4"
                android:textSize="11sp" />

            <Button
                android:id="@+id/chipTorch"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_glass_chip"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🔦 Torch"
                android:textColor="#ECEFF4"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Glass Conversation Log -->
    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvChatHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:text="✨ PKassist Ultra v3.0 (Gemini Glass Edition)\n\n1. 🔓 Voice Device Unlock: Upar '🔐 PIN' daba kar apna Lock-Screen PIN save karein. Jab phone lock ho, tab 'Unlock phone' ya 'Password 1234' bolein—PKassist screen on karke swipe karega aur PIN daba kar phone unlock kar dega!\n2. 💬 Gemini Glass Popup: 'Launch Glass AI' dabayein—Google Gemini jaisa glowing glass popup har app aur lock screen ke upar chalega aur background me hamesha aapki aawaz sunega.\n3. 🧠 Smart Commands: WhatsApp message, Call, Alarm, YouTube, Volume, Torch, Screen Reading, aur har sawal ka jawab!\n"
            android:textColor="#ECEFF4"
            android:textSize="13.5sp" />
    </ScrollView>

    <!-- Bottom Glass Input & Gemini Orb Mic Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_input"
            android:hint="Ask anything or give any command..."
            android:imeOptions="actionSend"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#90A4AE"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#263238"
            android:text="Send"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_gemini_orb"
            android:text="✨ Speak"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- Branded Footer: "— powered by RV GROUP —" -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivRvFooter"
            android:layout_width="210dp"
            android:layout_height="34dp"
            android:adjustViewBounds="true"
            android:background="@drawable/bg_footer_pill"
            android:contentDescription="Powered by RV Group"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/rv_footer_badge" />

        <TextView
            android:id="@+id/tvVersionFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="v3.0.1 • Gemini Glass Popup &amp; Lock-Screen Voice Unlock Active"
            android:textColor="#90A4AE"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
